# AwaBus API settings. Copy to .env and fill in; never commit .env.
# Only MONGO_URI and JWT_SECRET are required to start the server.

# --- Required
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# How long a sign-in lasts (default 7d)
JWT_EXPIRES_IN=7d

# --- Server
PORT=5000
# "production" hides error details from API responses
NODE_ENV=development

# --- Web access (CORS): admin site addresses allowed to call the API
CLIENT_URL=http://localhost:5173
DEPLOYED_URL=
CODESPACE_URL=

# --- SMS (Arkesel). Without these, messages are only written to the server log.
SMS_PROVIDER=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
# true = Arkesel sandbox (nothing is really delivered)
ARKESEL_SANDBOX=false
# Leave empty for the real Arkesel API (tests point this at a mock)
ARKESEL_BASE_URL=

# --- Parent alerts: texts when a child boards / is dropped off and when the
# bus is near home. Each is a paid SMS, so off unless set to true.
PARENT_ALERTS=false

# --- Arrival calls (voice). Off unless VOICE_PROVIDER=arkesel and the settings
# below are filled in; until then the near-home alert is a text. Call results
# (ringing, answered, not picked up...) show on the student's card in the
# driver app. Give Arkesel this webhook address for call results:
#   https://<your server>/api/webhooks/voice?token=<VOICE_WEBHOOK_TOKEN>
VOICE_PROVIDER=
# The recorded message parents hear (address of the audio file)
ARKESEL_VOICE_FILE_URL=
# Optional: Arkesel's voice-call API address, if different from the default
ARKESEL_VOICE_URL=
# A long random word, only shared with Arkesel (in the webhook address)
VOICE_WEBHOOK_TOKEN=
# This server's public address, e.g. https://awabus-api.onrender.com
SERVER_PUBLIC_URL=

# --- Codes and limits
OTP_EXPIRES_MINUTES=10
# One-time codes are printed in the server log unless this is false.
# Set false in production once SMS/email delivery is live.
LOG_OTP_CODES=false
# off disables sign-in / code request limits (automated tests only)
RATE_LIMITS=

# --- Development helpers
# true moves buses along their routes for demos (never in production)
TRIP_SIMULATOR=false
# Self-hosted GhanaPostGPS lookup service (optional)
GHANAPOSTGPS_API_URL=

# --- Only for the one-off superadmin script (src/scripts/seedSuperadmin.js)
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=
SEED_SUPERADMIN_PHONE=

# Bus assistant page (teacher on bus duty scans a QR code in the driver app).
# The admin website's public address; in a Codespace it is worked out
# automatically (port 5173), otherwise CLIENT_URL is used.
# ASSIST_APP_URL=https://admin.yourschool.example
