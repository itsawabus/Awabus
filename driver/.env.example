# Backend the driver app talks to. EXPO_PUBLIC_ vars are inlined into the JS
# bundle when Expo builds it, so restart Expo (npx expo start --clear) after
# changing this. A phone can't reach "localhost" - use one of:
#
#   npm run api:render      the deployed server (default when this is unset)
#   npm run api:codespace   the server running in your GitHub Codespace
#   npm run api -- http://192.168.1.20:5000/api   your computer's LAN IP
#
# Those commands write the line below into driver/.env for you.
EXPO_PUBLIC_API_URL=https://awabus.onrender.com/api
