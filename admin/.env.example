# Backend API. For local development (including Codespaces) use "/api": Vite
# proxies it to the server on localhost:5000, so no CORS or port setup is needed.
VITE_API_URL=/api
# Live updates (bus positions). When the page is not opened on localhost (for
# example in a Codespace), a localhost address here is ignored and the updates
# go through the same address as the page, forwarded by Vite like /api.
VITE_SOCKET_URL=http://localhost:5000

# Deployed backend (use instead of the above to run against production)
# VITE_API_URL=https://awabus.onrender.com/api
# VITE_SOCKET_URL=https://awabus.onrender.com

# Optional: Mapbox public token (pk.…) for a Hybrid map view that labels roads,
# buildings and points of interest. Free tier at https://account.mapbox.com
# VITE_MAPBOX_TOKEN=
